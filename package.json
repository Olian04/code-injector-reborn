{
  "name": "code-injector",
  "version": "0.4.0",
  "description": "Inject code into websites! (JavaScript, CSS, HTML and Files)",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "extension dev --browser=chrome --polyfill --no-telemetry",
    "start": "extension start --browser=chrome --polyfill --no-telemetry",
    "build": "extension build --browser=chrome,firefox,edge --polyfill --no-telemetry",
    "build:chrome": "extension build --browser=chrome --polyfill --no-telemetry",
    "zip": "extension build --browser=chrome,firefox,edge --polyfill --zip --no-telemetry",
    "preview": "extension preview --browser=chrome --polyfill --no-telemetry",
    "test": "npm run build:chrome && playwright test",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "publish:chrome": "node tools/publish-chrome.mjs",
    "postinstall": "node tools/copy-monaco.mjs"
  },
  "author": "Oliver Anteros (@Olian04)",
  "contributors": [
    "L. Sabatelli (@Lor-Saba) - original author"
  ],
  "license": "GPL-3.0",
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.2",
    "@types/chrome": "^0.2.2",
    "@types/react": "^18.2.64",
    "@types/react-dom": "^18.2.21",
    "@types/webextension-polyfill": "^0.12.5",
    "extension": "^4.0.22",
    "monaco-editor": "0.52.2",
    "sass": "^1.102.0",
    "typescript": "^5.8.2",
    "webextension-polyfill": "^0.12.0"
  }
}
